# Copy to .env and adjust. Every variable is optional — the defaults point
# at the real backend over Tailscale and work as-is.

# ---------------------------------------------------------------------------
# Backend
# ---------------------------------------------------------------------------

# Host:port of Aditya's FastAPI backend. Read by vite.config.js only, which
# proxies /api and /ws to it, so the browser never makes a cross-origin
# request and the backend's CORS allow-list never applies. Change it here
# and both REST and WebSocket follow.
VITE_BACKEND_HOST=sanjays-macbook-air.tail833b77.ts.net:8000

# Optional override that BYPASSES the Vite proxy and connects the WebSocket
# straight to this URL. Only useful for pointing at the mock sender while
# working offline:
#   cd backend && python mocks/mock_ws_sender.py
# Leave it unset for normal use.
# VITE_WS_URL=ws://localhost:8001

# ---------------------------------------------------------------------------
# Room
# ---------------------------------------------------------------------------

# The room this dashboard shows. There is exactly one room in the current
# build. Must stay lowercase snake_case to match the firmware and database.
VITE_ROOM_ID=corridor_a

# ---------------------------------------------------------------------------
# 3D room model
# ---------------------------------------------------------------------------

# Path to a GLB scan of the real room, served from frontend/public/. The
# default is /room.glb; if that file is not there, the twin falls back to the
# simple box geometry and nothing breaks. Point this at /room-sample.glb to
# check the loader works before you have a real scan.
# VITE_ROOM_MODEL=/room.glb

# ---------------------------------------------------------------------------
# Camera laptops
# ---------------------------------------------------------------------------

# Where each CV producer serves the floor positions of the people it can see
# (cv/producer.py --http-port). Proxied by Vite, so the browser stays
# same-origin. A camera laptop that is not running simply contributes nobody.
# Defaults assume both producers run on this machine.
# VITE_CAM1_HOST=localhost:8010
# VITE_CAM2_HOST=192.168.1.42:8010

# ---------------------------------------------------------------------------
# Demo and AR flags
# ---------------------------------------------------------------------------

# Set to 1 to drive the whole UI from a built-in synthetic data generator
# instead of the network. The page shows a "DEMO DATA" badge while this is
# on so live and fake readings can never be confused. Insurance for a dead
# venue network — leave it off otherwise.
# VITE_DEMO=1

# Set to 1 to enable the camera-passthrough AR layer in the ?view=mobile
# view. Requires a secure context (HTTPS or localhost) — see the AR section
# of README.md. Falls back silently to the normal mobile view when the
# camera is unavailable, so this is safe to leave on.
# VITE_ENABLE_AR=1

# ---------------------------------------------------------------------------
# Notifications
# ---------------------------------------------------------------------------

# Only warn about a predicted threshold crossing when it is this many
# minutes away or sooner. Defaults to 15.
# VITE_TREND_ALERT_MINUTES=15
