# Shared config for EchoTwin. Copy to .env and fill in real values.
# All 192.0.2.x addresses below are documentation-only examples, not live hosts.
# Replace them with your own LAN/Tailscale addresses in the ignored .env file.
# A physical ESP32 needs the broker's reachable LAN address, not a Tailscale IP.

SERVER_IP=192.0.2.10
FRONTEND_IP=192.0.2.20
FIRMWARE_LAPTOP_IP=192.0.2.30

# Example broker address for laptop clients. Replace before use.
MQTT_BROKER_HOST=192.0.2.10
MQTT_BROKER_PORT=1883

# Reject broken-clock sensor readings outside this live-data window
SENSOR_TIMESTAMP_MAX_AGE_SECONDS=300
SENSOR_TIMESTAMP_FUTURE_TOLERANCE_SECONDS=60

# Restricted hours: any occupancy at all inside this local window is flagged
# critical, on the basis that the space should be empty. Blank or equal bounds
# disable it. The window may cross midnight (22:00 -> 06:00).
# The offset is minutes, not a zone name — the slim container has no tzdata.
# 330 = IST. Set both bounds to demo it, e.g. RESTRICTED_HOURS_START=06:00
# and RESTRICTED_HOURS_END=07:00 to cover a 06:30 rehearsal.
RESTRICTED_HOURS_START=
RESTRICTED_HOURS_END=
RESTRICTED_HOURS_UTC_OFFSET_MINUTES=330

# PostgreSQL / TimescaleDB
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=echotwin
POSTGRES_USER=echotwin
POSTGRES_PASSWORD=changeme

# Browser origins allowed to call the REST API (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://192.0.2.20:3000,http://192.0.2.20:5173

# Optional Ollama host. Replace this example, or leave the URL empty to disable.
TAILSCALE_OLLAMA_URL=http://192.0.2.40:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT_SECONDS=20

# Optional maintenance sidecar: docker compose --profile maintenance ...
# Real calls require an explicit mode change plus provider credentials.
MAINTENANCE_NOTIFICATION_MODE=dry_run
MAINTENANCE_API_PORT_FORWARD=8002
MAINTENANCE_REVIEW_SECONDS=180
MAINTENANCE_WINDOW_SECONDS=300
MAINTENANCE_URGENT_SECONDS=15
MAINTENANCE_WARNING_PERSISTENCE_SECONDS=120
MAINTENANCE_CRITICAL_PERSISTENCE_SECONDS=30
MAINTENANCE_SENSOR_STALE_SECONDS=30
MAINTENANCE_CAMERA_STALE_SECONDS=30
# 1 for USB serial producer; set 7.5 for direct firmware MQTT at that cadence.
MAINTENANCE_SAMPLE_SECONDS=1
MAINTENANCE_COOLDOWN_SECONDS=900
MAINTENANCE_ROOMS=corridor_a
MAINTENANCE_CAMERAS=cam1,cam2
MAINTENANCE_USE_LLM=1
# Optional; leave blank for dry runs. Never commit real credentials.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
MAINTENANCE_CALL_TO=
