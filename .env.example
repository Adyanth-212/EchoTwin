# Shared config for EchoTwin. Copy to .env and fill in real values.
# Laptop 3 (server) is the fixed reference point for the venue network.

# Fixed IP of Laptop 3 on the venue hotspot LAN
SERVER_IP=192.168.1.100

# Mosquitto MQTT broker host (usually same as SERVER_IP)
MQTT_BROKER_HOST=192.168.1.100
MQTT_BROKER_PORT=1883

# PostgreSQL / TimescaleDB
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=echotwin
POSTGRES_USER=echotwin
POSTGRES_PASSWORD=changeme

# Tailscale address of the home PC running Ollama
TAILSCALE_OLLAMA_URL=http://100.x.x.x:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_SECONDS=2.5
